# Copy to .env; never commit a real API key.
VLM_API_KEY=
AGENT_LLM_PROVIDER=openai
AGENT_LLM_BASE_URL=https://www.dmxapi.cn/v1
AGENT_LLM_MODEL=doubao-seed-2-0-mini-260215
AGENT_LLM_TEMPERATURE=0
AGENT_LLM_MAX_TOKENS=1500
AGENT_LLM_TIMEOUT_SEC=60
# Retries exclude the first attempt: 2 retries = at most 3 attempts.
AGENT_LLM_MAX_RETRIES=2
AGENT_LLM_COMPLETION_GOVERNOR=0
AGENT_LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
# For M2, set model=qwen3.7-flash and EXTRA_BODY={"enable_thinking":false}
AGENT_EMBEDDING_PROVIDER=docsem
AGENT_CONTROL_TRANSPORT=inproc
AGENT_TEXT_STYLE=lean
AGENT_DATA_DIR=.local/runtime_data
AGENT_LLM_COALESCE=off
AGENT_LLM_ADVISORY=0
